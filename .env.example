# VibzCode Platform Configuration Template
# Copy this file to .env and configure your keys

# Server Configuration
PORT=3333
ADMIN_USER=admin
ADMIN_PASS=@change_this_password

# Google Gemini API Key (for LLM reasoning, code analysis, and skill distillation)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# MemoryZ Substrate (Sovereign Shared Memory & Tasks)
# Hosted instance: https://memoryz.wino.deno.net or local instance
MEMORYZ_URL=https://memoryz.wino.deno.net
MEMORYZ_TOKEN=

# TypeSafe Jev AI (System One Evaluation & Intent Routing)
# Optional: Get key at https://typesafe.ai
JEV_AI_KEY=
DISABLE_JEV=false

# Optional Provider Keys (for specific CLI engines like Claude Code or Codex)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
